    return true, cachedLink
end

-- ✅ Validate the key (identifier is REQUIRED by Platoboost)
local function redeemKey(key)
    local isConnected = checkConnectivity()
    if not isConnected then
        return false, "Network Error! Use a VPN or change your executor."
    end

    local nonce = generateNonce()
    local body = {identifier = lDigest(fGetHwid()), key = key}
    if CONFIG.USE_NONCE then body.nonce = nonce end
    
    local response, err = safeRequest({
        Url = host .. "/public/redeem/" .. fToString(CONFIG.SERVICE_ID),
        Method = "POST",
        Body = lEncode(body),
        Headers = {["Content-Type"] = "application/json"}
    })
    
    if response and response.StatusCode == 200 then
        local decoded = lDecode(response.Body)
        if decoded.success and decoded.data.valid then
            if CONFIG.USE_NONCE then
                if decoded.data.hash == lDigest("true" .. "-" .. nonce .. "-" .. CONFIG.PLATO_SECRET) then 
                    return true, "Success" 
                end
                return false, "Integrity Check Failed"
            end
            return true, "Success"
        end
        return false, decoded.message or "Invalid Key"
    end
    return false, err or "Server Error"
end

-------------------------------------------------------------------------------
--! LOCAL KEY LOCK (HWID + UserId) — ANTI-SHARING
-------------------------------------------------------------------------------
local function getCurrentHwid()
    return lDigest(fGetHwid())
end

local function getCurrentUserId()
    return tostring(LocalPlayer and LocalPlayer.UserId or 0)
end

local function clearSavedKey()
    if writefile then
        pcall(function() writefile(CONFIG.SAVE_FILE, "") end)
    end
end

-- Save format: key|hwid|userId
local function saveKeyWithLock(key)
    if not CONFIG.LOCK_ENABLED then
        if writefile then pcall(function() writefile(CONFIG.SAVE_FILE, key) end) end
        return
    end
    local data = key .. "|" .. getCurrentHwid() .. "|" .. getCurrentUserId()
    if writefile then
        pcall(function() writefile(CONFIG.SAVE_FILE, data) end)
    end
end

-- Returns: key, hwid, userId (hwid/userId can be nil for old format)
local function loadKeyWithLock()
    if not (readfile and isfile and isfile(CONFIG.SAVE_FILE)) then 
        return nil 
    end
    local ok, data = pcall(readfile, CONFIG.SAVE_FILE)
    if not ok or not data or data == "" then 
        return nil 
    end
    local k, h, u = data:match("^([^|]+)|([^|]+)|([^|]+)$")
    if k then
        return k, h, u
    end
    return data, nil, nil -- legacy format (only key)
end

-- Returns true if the lock matches (or there is no lock data to compare)
local function isLockCompatible(savedHwid, savedUserId)
    if not CONFIG.LOCK_ENABLED then return true end
    if not savedHwid or not savedUserId then return true end -- no lock info, allow & re-save
    if CONFIG.LOCK_BY_HWID and savedHwid ~= getCurrentHwid() then return false end
    if CONFIG.LOCK_BY_USERID and savedUserId ~= getCurrentUserId() then return false end
    return true
end

