-------------------------------------------------------------------------------

-- 🔒 Cooldown state (prevents spam clicking Verify Key)
local lastVerifyTime = 0
local isVerifying = false

-- Reusable key verification function
local function tryVerify(userKey, isAutoLogin)
    -- 🔒 Cooldown check (only for manual clicks — auto-login bypasses it)
    if not isAutoLogin then
        local now = fOsTime()
        if isVerifying or (now - lastVerifyTime) < CONFIG.VERIFY_COOLDOWN then
            local remaining = math.ceil(CONFIG.VERIFY_COOLDOWN - (now - lastVerifyTime))
            if remaining < 0 then remaining = 0 end
            StatusLabel.Text = "Please wait " .. remaining .. "s before trying again."
            StatusLabel.TextColor3 = Color3.fromRGB(255, 180, 100)
            return
        end
        lastVerifyTime = now
        isVerifying = true
    end

    if userKey == "" then
        StatusLabel.Text = "Please enter a key."
        StatusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
        isVerifying = false
        return
    end

    -- 🔒 LOCAL LOCK CHECK
    -- If the user is trying to use the SAME key that is already saved, enforce the lock.
    if CONFIG.LOCK_ENABLED then
        local prevKey, prevHwid, prevUid = loadKeyWithLock()
        if prevKey and prevKey == userKey then
            if not isLockCompatible(prevHwid, prevUid) then
                StatusLabel.Text = "This key is locked to another device/account!"
                StatusLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
                ShowToast("Key locked to another device/account.", 10)
                isVerifying = false
                return
            end
        end
    end

    if isAutoLogin then
        StatusLabel.Text = "Checking saved key..."
    else
        StatusLabel.Text = "Verifying key with PlatoBoost..."
    end
    StatusLabel.TextColor3 = Color3.fromRGB(255, 200, 100)

    task.spawn(function()
        local success, msg = redeemKey(userKey)
        if success then
            -- 🔒 Re-check lock one more time (paranoid check) and save
            local prevKey, prevHwid, prevUid = loadKeyWithLock()
            if CONFIG.LOCK_ENABLED and prevKey == userKey and prevHwid and prevUid then
                if not isLockCompatible(prevHwid, prevUid) then
                    StatusLabel.Text = "This key is locked to another device/account!"
                    StatusLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
                    ShowToast("Key locked to another device/account.", 10)
                    isVerifying = false
                    return
                end
            end

            -- Save key with current lock (HWID + UserId)
            saveKeyWithLock(userKey)

            StatusLabel.Text = "Key verified! Loading..."
            StatusLabel.TextColor3 = Color3.fromRGB(100, 255, 150)
            task.wait(0.6)
            ScreenGui:Destroy()
            ShowToast("Key active! Welcome back.", 10)
            LoadMainScript()
        else
            StatusLabel.Text = msg or "Invalid or expired key!"
            StatusLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
            -- If auto-login failed, clear the stale saved key
            if isAutoLogin then
                clearSavedKey()
            end
        end
        isVerifying = false
    end)
end

